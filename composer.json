{
    "name": "raow/mautic-rss-to-email-bundle",
    "description": "Mautic plugin that renders RSS/Atom feed items inside e-mails",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Chris Schrijver",
            "email": "chris@raow.nl"
        }
    ],
    "require": {
        "php": ">=8.4",
        "simplepie/simplepie": "^1.9"
    },
    "extra": {
        "install-directory-name": "MauticRssToEmailBundle"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "platform-check": false
    }
}
